# 複製成 .env 再填；不要把 .env 放進任何公開的地方
# 載入：set -a; source .env; set +a

# MiniMax：翻譯（translate.py）與配音（drama_tts.py／tts.py）
MINIMAX_API_KEY=
# 預設是中國站（製作者實際使用）；國際站帳號可改成 https://api.minimax.io（翻譯與配音都走這個位址，製作者沒有實測過國際站）
MINIMAX_HOST=https://api.minimaxi.com

# 百鍊（選用：只有選角寫 bailian:<voice> 才會用到）
BAILIAN_API_KEY=
# BAILIAN_TTS_URL=

# 額度查詢只支援 MiniMax 中國站 Token Plan（translate／drama_tts／tts／produce 都會查）
# 設 0＝完全不查額度（工具會印「quota not queried」，不會假造剩餘額度）；國際站或其他方案一定要設 0
# 只有中國站 Token Plan 才可以設成 1–100（週額度低於這個百分比 produce.py 就停）
SD_QUOTA_FLOOR=0

# 配樂：要跑 produce.py 就一定要設（你有授權的音樂檔）；只要無配樂版就不設，也不要跑 produce.py（見 SKILL.md 的B路線）
# SD_MUSIC_BED=/path/to/your-music.flac

# 品管用的 whisper 指令
# WHISPER_BIN=/path/to/whisper

# Shorts 說明欄要帶的頻道網址（shorts_check.py 會檢查）
SD_CHANNEL_URL=https://www.youtube.com/@YOUR_CHANNEL

# 字型放在別處時（art.py的宋體與Baskerville仍固定用macOS系統字型，見README）
# SD_FONT_PINGFANG=/path/to/PingFang.ttc
# SD_FONT_NOTO_BLACK=/path/to/NotoSansCJKtc-Black.otf
# SD_FONT_NOTO_BOLD=/path/to/NotoSansCJKtc-Bold.otf
